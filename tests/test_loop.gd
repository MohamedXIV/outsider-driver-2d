extends SceneTree

# Repeat the *same authored* ride twice. It is a bounded daily-loop proof,
# not an assertion of a two-passenger content catalog.
func _initialize() -> void:
	var session: GameSession = GameSession.new()
	assert(not session.service_vehicle())
	assert(not session.return_to_garage())
	_walk_to(session, GameSession.WORKBENCH)
	assert(session.select_starter_device("radio"))
	_walk_to(session, GameSession.TAXI_DOOR)
	assert(session.pickup())
	assert(not session.return_to_garage())
	session.apply_story_tags("ride:1:passenger-choice", ["suspicion:1"])
	session.apply_story_tags("ride:1:passenger-choice", ["suspicion:1"])
	assert(session.suspicion == 1)
	session.advance(100.0)
	assert(session.phase == GameSession.RidePhase.ARRIVED)
	assert(session.drop_off())
	assert(session.completed_rides == 1 and session.credits == 18)
	assert(session.service_due)
	assert(not session.drop_off())
	assert(not session.service_vehicle(), "Cannot repair away from garage.")
	assert(session.return_to_garage())
	assert(not session.return_to_garage(), "Must not return twice.")
	assert(session.day_number() == 2)
	assert(session.ride.world_position() == GameSession.new().ride.world_position())
	assert(session.starter_device == "radio")
	assert(not session.pickup(), "Service is due, even if the taxi is reachable.")
	var saved_due: GameSession = GameSession.new()
	assert(saved_due.restore_snapshot(session.snapshot()))
	assert(saved_due.completed_rides == 1 and saved_due.service_due)
	assert(saved_due.credits == 18 and saved_due.day_number() == 2)
	_walk_to(saved_due, GameSession.WORKBENCH)
	assert(saved_due.service_vehicle())
	assert(saved_due.credits == 12 and saved_due.service_count == 1)
	assert(not saved_due.service_vehicle(), "Service paid twice.")
	var serviced: GameSession = GameSession.new()
	assert(serviced.restore_snapshot(saved_due.snapshot()))
	assert(not serviced.service_due and serviced.credits == 12)
	_walk_to(serviced, GameSession.TAXI_DOOR)
	assert(serviced.pickup())
	serviced.apply_story_tags("ride:2:passenger-choice", ["suspicion:1"])
	assert(serviced.suspicion == 2, "Second Ink consequence must not reuse the first event ID.")
	assert(serviced.known_facts.has("radio:two-local-languages"))
	serviced.advance(100.0)
	assert(serviced.drop_off())
	assert(serviced.completed_rides == 2)
	assert(serviced.credits == 30, "18 + 18 - 6, exactly once per fare/service.")
	assert(serviced.service_due and serviced.service_count == 1)
	var after_second: GameSession = GameSession.new()
	assert(after_second.restore_snapshot(serviced.snapshot()))
	assert(not after_second.drop_off(), "Restored completed ride paid again.")
	assert(after_second.return_to_garage())
	assert(after_second.day_number() == 3)
	_walk_to(after_second, GameSession.WORKBENCH)
	assert(after_second.service_vehicle())
	assert(after_second.credits == 24 and after_second.service_count == 2)
	assert(not after_second.service_vehicle())
	var invalid: Dictionary = serviced.snapshot()
	invalid["service_count"] = 3
	assert(not GameSession.new().restore_snapshot(invalid))
	invalid = serviced.snapshot()
	invalid["service_due"] = false
	assert(not GameSession.new().restore_snapshot(invalid))
	print("P2_LOOP_NATIVE_PASS")
	quit(0)


func _walk_to(session: GameSession, goal: Vector2) -> void:
	for step in range(40):
		if session.garage_position.distance_to(goal) <= 0.38:
			break
		assert(session.move_in_garage(goal - session.garage_position))
	assert(session.garage_position.distance_to(goal) <= GameSession.INTERACT_RADIUS)
